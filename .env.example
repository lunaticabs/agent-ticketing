# ============================================================================
#  Presence — environment template
#  Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ============================================================================

# ── World ID Human Continuity IdP (sandbox) ─────────────────────────────────
# Register an OIDC client at https://sandbox.auth.world.org/portal and put the
# values here. Until both are set, the app runs the documented LOCAL FALLBACK
# (worldid/local.ts) and says so loudly on every screen. See SPIKE_NOTES.md S-2.
#
# RED LINE 2: these are server-side secrets. They are never sent to a client.
WORLDID_CLIENT_ID=
WORLDID_CLIENT_SECRET=
# The redirect URI must match the portal registration byte for byte.
#
# NOTE THE SCHEME: the sandbox portal requires HTTPS, even for a loopback
# callback — it rejects an http:// URL with "Check the values and try again."
# Run `npm run dev:https` and register the https:// form below.
WORLDID_REDIRECT_URI=https://localhost:3000/api/auth/world/callback
# `client_secret_basic` (portal default) or `client_secret_post`.
WORLDID_TOKEN_AUTH_METHOD=client_secret_basic
# Override only to point at a different deployment of the same IdP.
WORLDID_ISSUER=https://sandbox.auth.world.org

# ── This app ────────────────────────────────────────────────────────────────
# Public base URL. Must match the registered redirect URI, scheme included.
# `npm run dev:https` sets this for you; it is only needed if you start Next
# yourself.
PRESENCE_PUBLIC_URL=https://localhost:3000
# HMAC key for sessions and local assertions. Generate with:
#   openssl rand -base64 48
PRESENCE_SIGNING_KEY=

# ── Demo props ──────────────────────────────────────────────────────────────
# ⚠️ Enables /api/dev/* — simulated humans that bypass World ID entirely.
# Required for demo beats 1 and 4. Never enable in a deployment that matters.
ENABLE_DEV_ROUTES=0

# Optional: override the SQLite file location.
# PRESENCE_DB=./db/presence.db
