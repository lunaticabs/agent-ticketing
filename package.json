{
  "name": "presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Presence \u2014 agent queueing with fresh human authorization at the moment a slot is handed over.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "tsx db/seed.ts",
    "reset": "tsx db/reset.ts && tsx db/seed.ts",
    "agent": "tsx agent/runner.ts",
    "mcp": "tsx mcp/server.ts",
    "bots": "tsx scripts/bot-army.ts",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json tsx --test tests/*.test.ts",
    "spike": "tsx scripts/spike.ts",
    "security-check": "tsx scripts/security-check.ts",
    "e2e": "tsx scripts/e2e.ts",
    "verify": "npm run test && npm run e2e && npm run mcp-check && npm run build && npm run security-check",
    "mcp-check": "tsx scripts/mcp-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "next": "15.5.26",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
